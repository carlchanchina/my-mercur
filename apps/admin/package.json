{
  "name": "@acme/admin",
  "private": true,
  "version": "2.3.7",
  "type": "module",
  "scripts": {
    "dev": "vite --port 7000",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -b",
    "test": "exit 0",
    "preview": "vite preview --port 7000"
  },
  "dependencies": {
    "@mercurjs/admin": "2.3.7",
    "i18next": "26.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1"
  }
}
