{
  "name": "@acme/admin",
  "private": true,
  "version": "2.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port 7000",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -b",
    "test": "exit 0",
    "preview": "vite preview --port 7000"
  },
  "dependencies": {
    "@mercurjs/admin": "2.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1"
  }
}
