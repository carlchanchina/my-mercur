# Repo-level env example for Docker Compose / Dokploy.
# Copy to `.env` locally or set these in Dokploy project env.
# ---------------------------
# Infrastructure
# ---------------------------
POSTGRES_USER=mercur
POSTGRES_PASSWORD=mercur
POSTGRES_DB=mercur
REDIS_URL=redis://redis:6379

# ---------------------------
# Backend API
# ---------------------------
DATABASE_URL=postgres://mercur:mercur@postgres:5432/mercur
STORE_CORS=https://your-storefront.example.com
ADMIN_CORS=https://your-admin.example.com
VENDOR_CORS=https://your-vendor.example.com
AUTH_CORS=https://your-admin.example.com,https://your-vendor.example.com,https://your-storefront.example.com
JWT_SECRET=
COOKIE_SECRET=
FILE_BACKEND_URL=https://your-api.example.com/static
MEDUSA_BACKEND_URL=https://your-api.example.com
MEDUSA_ADMIN_ONBOARDING_TYPE=default

# Integrations
RESEND_API_KEY=
RESEND_FROM=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
TALKJS_APP_ID=
TALKJS_SECRET_KEY=
TALKJS_PUBLIC_KEY=
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_INDEX_PREFIX=mercur

# ---------------------------
# Storefront
# ---------------------------
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://your-api.example.com
NEXT_PUBLIC_BASE_URL=https://your-storefront.example.com
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=
NEXT_PUBLIC_ALGOLIA_INDEX_PREFIX=mercur
NEXT_PUBLIC_TALKJS_APP_ID=

# ---------------------------
# Dashboards
# ---------------------------
VITE_MEDUSA_BACKEND_URL=https://your-api.example.com
